# Copy to .env (gitignored).

# LLM for resume tailoring and cover notes. Either:
# Azure OpenAI, signing in with `az login` (no key):
AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# or Groq (set LLM_PROVIDER=groq): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Adzuna job search API (optional; 25 test calls, then a paid plan): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Where jobs and applications are stored
# DATABASE_URL=sqlite:///jobhunter.db

# Path to your profile (default: profile.toml)
# JOBHUNTER_PROFILE=profile.toml
