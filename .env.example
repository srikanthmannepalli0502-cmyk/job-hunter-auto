# Copy to .env (gitignored).

# Required for resume tailoring. Free key: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Adzuna job search API. Free developer key: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Where jobs and applications are stored
# DATABASE_URL=sqlite:///jobhunter.db

# Path to your profile (default: profile.toml)
# JOBHUNTER_PROFILE=profile.toml
